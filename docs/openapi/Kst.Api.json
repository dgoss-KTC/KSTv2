{
  "openapi": "3.1.1",
  "info": {
    "title": "Kst.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "Returns liveness status of the backend process.",
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "Returns readiness status once initialization is complete.",
        "operationId": "GetReady",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/status": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Returns typed system status for the frontend walking skeleton.",
        "operationId": "GetSystemStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/refresh": {
      "post": {
        "tags": [
          "System"
        ],
        "summary": "Triggers a refresh cycle across all registered data sources and returns the resulting status.",
        "operationId": "PostSystemRefresh",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces": {
      "get": {
        "tags": [
          "Workspaces"
        ],
        "summary": "Returns the saved workspace list and any nonfatal configuration warning.",
        "operationId": "ListWorkspaces",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceListResponseDto"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Workspaces"
        ],
        "summary": "Creates and persists a new workspace configuration.",
        "operationId": "CreateWorkspace",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkspaceRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceAssignmentDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Workspaces"
        ],
        "summary": "Removes all workspace configuration and returns to the empty startup state.",
        "operationId": "ResetWorkspaces",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/workspaces/{assignmentId}": {
      "put": {
        "tags": [
          "Workspaces"
        ],
        "summary": "Updates and persists an existing workspace configuration.",
        "operationId": "UpdateWorkspace",
        "parameters": [
          {
            "name": "assignmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkspaceRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceAssignmentDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Workspaces"
        ],
        "summary": "Permanently deletes a workspace assignment from configuration.",
        "operationId": "DeleteWorkspace",
        "parameters": [
          {
            "name": "assignmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/{assignmentId}/archive": {
      "post": {
        "tags": [
          "Workspaces"
        ],
        "summary": "Archives a workspace so it no longer appears as an active tab (isEnabled = false).",
        "operationId": "ArchiveWorkspace",
        "parameters": [
          {
            "name": "assignmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceAssignmentDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/{assignmentId}/restore": {
      "post": {
        "tags": [
          "Workspaces"
        ],
        "summary": "Restores a previously archived workspace (isEnabled = true).",
        "operationId": "RestoreWorkspace",
        "parameters": [
          {
            "name": "assignmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceAssignmentDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/order": {
      "put": {
        "tags": [
          "Workspaces"
        ],
        "summary": "Persists a new tab order for the currently active (enabled) workspaces.",
        "operationId": "ReorderWorkspaces",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReorderWorkspacesRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceListResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/preferences": {
      "get": {
        "tags": [
          "Preferences"
        ],
        "summary": "Returns the current user preferences and any nonfatal configuration warning.",
        "operationId": "GetPreferences",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreferencesResponseDto"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Preferences"
        ],
        "summary": "Validates and persists updated user preferences.",
        "operationId": "UpdatePreferences",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePreferencesRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreferencesResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/{assignmentId}/mps": {
      "get": {
        "tags": [
          "Mps"
        ],
        "summary": "Returns the projected MPS dashboard for a workspace, auto-loading from QAD on first access.",
        "operationId": "GetMpsDashboard",
        "parameters": [
          {
            "name": "assignmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "dateBasis",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "horizonWeeks",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MpsDashboardResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/{assignmentId}/mps/refresh": {
      "post": {
        "tags": [
          "Mps"
        ],
        "summary": "Forces one reload of MPS source facts from QAD for the workspace and returns the projected dashboard.",
        "operationId": "RefreshMpsDashboard",
        "parameters": [
          {
            "name": "assignmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "dateBasis",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "horizonWeeks",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MpsDashboardResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/{assignmentId}/part-detail": {
      "get": {
        "tags": [
          "PartDetail"
        ],
        "summary": "Returns lazily-loaded Part Info for a workspace's selected MPS parent part.",
        "operationId": "GetPartDetail",
        "parameters": [
          {
            "name": "assignmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "partNumber",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartDetailResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateWorkspaceRequestDto": {
        "required": [
          "displayName",
          "site",
          "productLineFrom",
          "productLineTo",
          "parentParts",
          "isTemporary",
          "coverageEndsOn"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "site": {
            "type": [
              "null",
              "string"
            ]
          },
          "productLineFrom": {
            "type": [
              "null",
              "string"
            ]
          },
          "productLineTo": {
            "type": [
              "null",
              "string"
            ]
          },
          "parentParts": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "isTemporary": {
            "type": "boolean"
          },
          "coverageEndsOn": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "DataSourceDto": {
        "required": [
          "name",
          "status"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status",
          "application",
          "backendVersion",
          "processId",
          "instanceId",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "application": {
            "type": "string"
          },
          "backendVersion": {
            "type": "string"
          },
          "processId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "instanceId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MpsBucketDto": {
        "required": [
          "kind",
          "weekLabel",
          "quantity",
          "executionStatus",
          "containsPlannedWork",
          "containsExplicitlyScheduledWork"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "weekLabel": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "executionStatus": {
            "type": "string"
          },
          "containsPlannedWork": {
            "type": "boolean"
          },
          "containsExplicitlyScheduledWork": {
            "type": "boolean"
          }
        }
      },
      "MpsDashboardResponseDto": {
        "required": [
          "snapshot",
          "dateBasis",
          "horizonWeeks",
          "parts"
        ],
        "type": "object",
        "properties": {
          "snapshot": {
            "$ref": "#/components/schemas/MpsSnapshotMetadataDto"
          },
          "dateBasis": {
            "type": "string"
          },
          "horizonWeeks": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MpsPartScheduleDto"
            }
          }
        }
      },
      "MpsPartScheduleDto": {
        "required": [
          "parentPart",
          "description",
          "buckets"
        ],
        "type": "object",
        "properties": {
          "parentPart": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "buckets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MpsBucketDto"
            }
          }
        }
      },
      "MpsSnapshotMetadataDto": {
        "required": [
          "snapshotId",
          "createdAtUtc",
          "lastSuccessfulRefreshAtUtc",
          "status",
          "workspaceId",
          "site",
          "resolvedParentPartCount",
          "sourceRowCount",
          "isRefreshInProgress",
          "lastRefreshError"
        ],
        "type": "object",
        "properties": {
          "snapshotId": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastSuccessfulRefreshAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "site": {
            "type": [
              "null",
              "string"
            ]
          },
          "resolvedParentPartCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "sourceRowCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isRefreshInProgress": {
            "type": "boolean"
          },
          "lastRefreshError": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PartDetailResponseDto": {
        "required": [
          "site",
          "partNumber",
          "plannerCode",
          "manufacturingLeadTimeDays",
          "safetyTimeDays",
          "partStatusCode",
          "partStatusDescription",
          "currentRevision",
          "description",
          "iosCode",
          "safetyStockQuantity",
          "quantityOnHand",
          "quantityNonNet",
          "quantityRmaOnHand",
          "priceBreaks",
          "loadedAtUtc",
          "isStale",
          "warning"
        ],
        "type": "object",
        "properties": {
          "site": {
            "type": "string"
          },
          "partNumber": {
            "type": "string"
          },
          "plannerCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "manufacturingLeadTimeDays": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "safetyTimeDays": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "partStatusCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "partStatusDescription": {
            "type": [
              "null",
              "string"
            ]
          },
          "currentRevision": {
            "type": [
              "null",
              "string"
            ]
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "iosCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "safetyStockQuantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "quantityOnHand": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "quantityNonNet": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "quantityRmaOnHand": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "priceBreaks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartPriceBreakDto"
            }
          },
          "loadedAtUtc": {
